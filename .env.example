# Server
NODE_ENV=development
PORT=3001

# Admin API Key (protects /api/admin and /api/llm)
ADMIN_API_KEY=admin-secret-key

# Telephony Adapter: simulator | twilio | asterisk | yeastar
TELEPHONY_ADAPTER=simulator

# Twilio Config
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Asterisk ARI Config
ASTERISK_ARI_URL=http://localhost:8088/ari
ASTERISK_ARI_APP=ivr-ai
ASTERISK_ARI_USER=ari
ASTERISK_ARI_PASSWORD=ari

# Yeastar Config
YEASTAR_API_URL=http://localhost:8088
YEASTAR_API_KEY=
YEASTAR_WEBHOOK_URL=

# LLM Configuration
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256
LLM_ENABLED=true

# Logging
LOG_LEVEL=info
